#!/bin/bash
# One-command layer gate: scanner + context linters, named failures, exit 0/1.
# Usage: check_layer.sh <repo-root>
set -u
REPO="${1:?usage: check_layer.sh <repo-root>}"
TOOLS="$(cd "$(dirname "$0")/.." && pwd)"
J=$(python3 "$TOOLS/scan/context_scan.py" --repo "$REPO" --json 2>/dev/null)
fail=0
say(){ echo "$@"; }
val(){ python3 -c "import json,sys;d=json.loads(sys.argv[1]);print(d$2)" "$J" 2>/dev/null; }

dups=$(val "$J" "['duplicate_lines']")
unrouted=$(val "$J" "len(d['dirs_unrouted'])" ); unrouted=$(python3 -c "import json;d=json.loads('''$J''');print(len(d['dirs_unrouted']))")
lint=$(python3 -c "import json;d=json.loads('''$J''');print(len(d['lint_overlap']))")
adr=$(val "$J" "['decision_docs_unreferenced']")
boot=$(val "$J" "['boot_tokens_est']")

[ "$dups" = "0" ]     || { say "FAIL duplicate_lines=$dups (must be 0) — run scanner for locations"; fail=1; }
[ "$unrouted" = "0" ] || { say "FAIL dirs_unrouted=$unrouted (must be 0):"; python3 -c "import json;d=json.loads('''$J''');print('\n'.join('  '+x for x in d['dirs_unrouted'][:15]))"; fail=1; }
[ "$lint" = "0" ]     || { say "FAIL lint_overlap=$lint (must be 0)"; fail=1; }
[ "$adr" = "0" ]      || { say "FAIL decision_docs_unreferenced=$adr (must be 0)"; fail=1; }

# PRESERVATION: no substantive line (>40 chars) of the committed context
# layer may be missing from the new layer (moved is fine, dropped is not)
LOST=$(python3 - "$REPO" <<'PYEOF'
import subprocess, re, sys
W=sys.argv[1]
tracked=subprocess.run(['git','-C',W,'ls-files','*.md','**/AGENTS.md','**/CLAUDE.md'],capture_output=True,text=True).stdout.split()
ctx=[f for f in tracked if f.endswith(('AGENTS.md','CLAUDE.md'))]
old=""
for f in ctx:
    r=subprocess.run(['git','-C',W,'show',f'HEAD:{f}'],capture_output=True,text=True)
    if r.returncode==0: old+=r.stdout+'\n'
new=""
allmd=set(tracked)|set(subprocess.run(['git','-C',W,'ls-files','-mo','--exclude-standard'],capture_output=True,text=True).stdout.split())
for f in allmd:
    if f.endswith('.md'):
        try: new+=open(f'{W}/{f}',errors='replace').read()+'\n'
        except OSError: pass
def norm(l): return re.sub(r'\s+',' ',l.strip().lower())
blob=norm(new.replace('\n',' '))
miss=[l.strip() for l in old.splitlines() if len(norm(l))>40 and norm(l) not in blob]
print(len(miss))
for m in miss[:6]: print('  LOST:',m[:90])
PYEOF
)
LN=$(echo "$LOST" | head -1)
[ "$LN" = "0" ] || { say "FAIL preservation: $LN substantive lines of the old layer are missing:"; echo "$LOST" | tail -n +2; fail=1; }

CHK=$(python3 "$TOOLS/icm/icm_check.py" --context "$REPO" --repo "$REPO" 2>/dev/null)
echo "$CHK" | grep -q '| R1 | PASS' || { say "FAIL R1: root router must carry an | area | path | read | skip | table"; fail=1; }
echo "$CHK" | grep -q '| R9 | PASS' || { say "FAIL R9: a table path does not resolve — paths must be repo-rooted"; echo "$CHK" | grep '| R9 |'; fail=1; }
head -1 "$REPO/AGENTS.md" 2>/dev/null | grep -q '^CLASS:' || { say "FAIL R3: root AGENTS.md line 1 must be 'CLASS: ...'"; fail=1; }

if [ "$fail" = "0" ]; then
  echo "PASS — layer clean · boot ≈ ${boot} tokens/session"
else
  echo "GATE: FAILED (fix the named items, re-run)"
fi
exit $fail

